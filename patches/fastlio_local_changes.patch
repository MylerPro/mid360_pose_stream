diff --git a/src/preprocess.cpp b/src/preprocess.cpp
index 88444f4..0f9cf40 100644
--- a/src/preprocess.cpp
+++ b/src/preprocess.cpp
@@ -549,9 +549,21 @@ void Preprocess::mid360_handler(const sensor_msgs::msg::PointCloud2::UniquePtr &
     yaw_last[layer] = yaw_angle;
     time_last[layer] = added_pt.curvature;
 
-    if (added_pt.x * added_pt.x + added_pt.y * added_pt.y + added_pt.z * added_pt.z > (blind * blind))
+    // 抽稀：与 velodyne_handler 完全一致的写法 —— 上面所有 yaw/时间状态
+    // 对【每个点】照常更新，只在入队前按 point_filter_num 取模过滤，
+    // 因此用 yaw 合成的点时间（curvature）完全不受影响。
+    //
+    // mid360_handler 原本漏了这一步：配置里 point_filter_num=3，而
+    // avia_handler / oust64_handler / velodyne_handler 三个都实现了，
+    // 只有这里没有 → 每帧硬吃约 15280 个点（19968 扣除 blind 内的），
+    // 单帧耗时约 100ms ≈ 输入间隔，于是启动阶段形成的约 13 帧积压
+    // 永远排不掉 → odom 时间戳比现在旧约 1.4s，闭环反馈延迟过大。
+    if (i % point_filter_num == 0)
     {
-      pl_surf.push_back(std::move(added_pt));
+      if (added_pt.x * added_pt.x + added_pt.y * added_pt.y + added_pt.z * added_pt.z > (blind * blind))
+      {
+        pl_surf.push_back(std::move(added_pt));
+      }
     }
   }
