diff --git a/CMakeLists.txt b/CMakeLists.txt
index 7344d08..9d4cb03 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -281,6 +281,25 @@ else(ROS_EDITION STREQUAL "ROS2")
 
   target_include_directories(${PROJECT_NAME} PRIVATE ${livox_sdk_INCLUDE_DIRS})
 
+  # Keep the SDK discoverable after installation for every driver launch file.
+  get_filename_component(LIVOX_LIDAR_SDK_LIBRARY_DIR "${LIVOX_LIDAR_SDK_LIBRARY}" DIRECTORY)
+  set_property(TARGET ${PROJECT_NAME} APPEND PROPERTY
+    INSTALL_RPATH "${LIVOX_LIDAR_SDK_LIBRARY_DIR}")
+
+  # ── 本地修复 ──────────────────────────────────────────────────────────
+  # 上游只【使用】 DISTRO_ROS 却从不定义它，靠外部 -DDISTRO_ROS=humble 传入。
+  # 全新工作空间没传的话会走 else 分支，而该分支里的
+  # get_target_property(...) 可能把 LIVOX_INTERFACES_INCLUDE_DIRECTORIES
+  # 设成 ...-NOTFOUND，CMake Generate 直接失败：
+  #   CMake Error: ... LIVOX_INTERFACES_INCLUDE_DIRECTORIES ... NOTFOUND
+  # （旧工作空间能编过只是因为它 CMakeCache 里残留着 DISTRO_ROS=humble）
+  # 这里从环境变量兜底，让全新 clone 也能编。
+  if(NOT DEFINED DISTRO_ROS AND DEFINED ENV{ROS_DISTRO})
+    set(DISTRO_ROS "$ENV{ROS_DISTRO}")
+    message(STATUS "DISTRO_ROS not given, defaulting to \$ROS_DISTRO=${DISTRO_ROS}")
+  endif()
+  # ─────────────────────────────────────────────────────────────────────
+
   # get include directories of custom msg headers
   if(DISTRO_ROS STREQUAL "humble" OR DISTRO_ROS STREQUAL "jazzy")
     rosidl_get_typesupport_target(cpp_typesupport_target
@@ -333,4 +352,4 @@ else(ROS_EDITION STREQUAL "ROS2")
     launch_ROS2
   )
 
-endif()
\ No newline at end of file
+endif()
